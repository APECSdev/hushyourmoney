# daemons/cashfusion/systemd/cashfusion-daemon.service
#
# Install:
#   sudo useradd --system --home /var/lib/cashfusion-daemon --shell /usr/sbin/nologin cashfusion
#   sudo install -d -o cashfusion -g cashfusion /opt/cashfusion-daemon
#   sudo install -m 600 /dev/null /etc/cashfusion-daemon.env
#   sudo install -m 644 cashfusion-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# The skeleton is not deployed. The unit uses Restart=on-failure with a start
# limit so a not-implemented build cannot loop forever.

[Unit]
Description=CashFusion-over-Nostr liquidity daemon
Documentation=file:///opt/cashfusion-daemon/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cashfusion
Group=cashfusion
UMask=0077
WorkingDirectory=/opt/cashfusion-daemon
EnvironmentFile=/etc/cashfusion-daemon.env
ExecStart=/usr/local/bin/node /opt/cashfusion-daemon/src/main.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cashfusion-daemon
StateDirectory=cashfusion-daemon
StateDirectoryMode=0700
RuntimeDirectory=cashfusion-daemon
RuntimeDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
CPUQuota=50%
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
