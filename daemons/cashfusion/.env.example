# daemons/cashfusion/.env.example
#
# Copy to /etc/cashfusion-daemon.env on blackhost, mode 600, owned by root.
# NEVER commit .env or .seed.

# ── Shared ────────────────────────────────────────────────────────────────
DAEMON_LOG_LEVEL=info
DAEMON_METRICS_ADDR=127.0.0.1:9102
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
NOSTR_RELAY_PACING_MS=80
NOSTR_AUTH_POLICY=optional

# ── CashFusion ────────────────────────────────────────────────────────────
CASHFUSION_NETWORK=chipnet
CASHFUSION_POOL_SIZE=5
CASHFUSION_MIN_PARTICIPANTS=5
CASHFUSION_FEE_SATS=5000
CASHFUSION_MAX_FEE_RATE=5
CASHFUSION_COORDINATOR_POLICY=avoid
CASHFUSION_MAX_FLOAT_SATS=300000
CASHFUSION_MAX_ROUNDS=10
CASHFUSION_SEED_FILE=/var/lib/cashfusion-daemon/.seed
CASHFUSION_DATA_DIR=/var/lib/cashfusion-daemon
