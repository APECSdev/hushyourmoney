# daemons/cashshuffle/.env.example
#
# Copy to /etc/cashshuffle-daemon.env on blackhost, mode 600, owned by root.
# NEVER commit .env or .seed.

# ── Shared ────────────────────────────────────────────────────────────────
DAEMON_LOG_LEVEL=info
DAEMON_METRICS_ADDR=127.0.0.1:9101
NOSTR_RELAYS=wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub
NOSTR_RELAY_PACING_MS=80
NOSTR_AUTH_POLICY=optional

# ── CashShuffle ───────────────────────────────────────────────────────────
CASHSHUFFLE_NETWORK=chipnet
CASHSHUFFLE_POOL_CATEGORY=480e30ff1d3f5f0b6fe9dd2dbe363b1776f61566f29a395628d0b50abd01b9d0
CASHSHUFFLE_POOL_LOCKING=aa203e40b64cff154d4b3305e8c8cc4e3174bc595ad74342a8445a9a7798b7be3a2987
CASHSHUFFLE_GUARD_LOCKING=aa2066a238ad4109a3093c34fd4cf9b4167b0058375d4ad1c5cc44cd253d3664f0c187
CASHSHUFFLE_VENDING_LOCKING=aa206b51396304b3bd4e0e9c254f84d1ee80d83a5c7ccaf3750883d00866480d981287
CASHSHUFFLE_VENDING_PRICE_SATS=1000
CASHSHUFFLE_FUEL_SATS=15000
CASHSHUFFLE_BLANKS_PER_LOCK=2
CASHSHUFFLE_POOL_SIZE=5
CASHSHUFFLE_AMOUNT_SATS=100000
CASHSHUFFLE_FEE_RATE=1
CASHSHUFFLE_MAX_FLOAT_SATS=400000
CASHSHUFFLE_MAX_ROUNDS=10
CASHSHUFFLE_MAX_LOCK_FEE_SATS=5000
CASHSHUFFLE_SEED_FILE=/var/lib/cashshuffle-daemon/.seed
CASHSHUFFLE_DATA_DIR=/var/lib/cashshuffle-daemon
